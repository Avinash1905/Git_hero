# GitHero Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your local environment.

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./server/database/gitquest.db

# Authentication & Cryptography (Replace with cryptographically secure secret in production)
JWT_SECRET=githero_secure_jwt_token_secret_placeholder_replace_in_production
JWT_EXPIRATION=7d

# Rate Limiter Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Client API Base URL
API_BASE_URL=http://localhost:3000/api
